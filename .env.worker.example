# ─────────────────────────────────────────────
# WORKER DEPLOYMENT (VPS 2 / Overflow)
# ─────────────────────────────────────────────
# Copy file ini ke .env dan isi value yang sesuai.
# Worker hanya butuh akses ke Database dan Redis di VPS 1.
# ─────────────────────────────────────────────

# Database (pointing ke MySQL di VPS 1)
DB_CONNECTION=mysql
DB_HOST=192.168.1.100
DB_PORT=3306
DB_DATABASE=halostory
DB_USERNAME=worker
DB_PASSWORD=change_me

# Redis (pointing ke Redis di VPS 1)
REDIS_HOST=192.168.1.100
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker concurrency (sesuaikan dengan CPU/RAM VPS 2)
# Default: 30 goroutines untuk BYOK + VIP System AI
# Untuk VPS kecil (2 vCPU/4GB RAM), gunakan 10-15
# Untuk VPS besar (4 vCPU/8GB RAM), gunakan 30-50
WORKER_CONCURRENCY=30

# Timezone
TZ=Asia/Jakarta
