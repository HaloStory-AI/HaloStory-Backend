# Email (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@halostory.app
MAIL_FROM_NAME=HaloStory

# Storage (S3-compatible — RustFS)
S3_KEY=
S3_SECRET=
S3_REGION=us-east-1
S3_BUCKET=bluetalk
S3_ENDPOINT=https://rustfs.aneent.dev

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_CHILD_SAFETY_WEBHOOK=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# AI System Keys
