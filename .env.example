# ─────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────
APP_NAME=HaloStory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:3000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# DATABASE (MySQL/MariaDB)
# ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bluetalk
DB_USERNAME=root
DB_PASSWORD=

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# MAIL (SMTP — Brevo/Sendinblue recommended)
# ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@halostory.ai"
MAIL_FROM_NAME="HaloStory AI"

# ─────────────────────────────────────────────
# OBJECT STORAGE (S3-compatible / MinIO)
# ─────────────────────────────────────────────
S3_KEY=
S3_SECRET=
S3_BUCKET=bluetalk
S3_ENDPOINT=
S3_URL_EXPIRY_HOURS=6

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
# Static bearer token required for pre-login endpoints (e.g. /api/login)
API_STATIC_TOKEN=

# ─────────────────────────────────────────────
# SYSTEM AI ROUTER (9Router)
# ─────────────────────────────────────────────
# OpenAI-compatible endpoint for System AI chat
ROUTER_SYSTEM_URL=https://router.my-bini.my.id/v1
# API key dari dashboard 9Router
ROUTER_SYSTEM_KEY=

# Default max tokens for AI responses
DEFAULT_MAX_TOKENS=800

# Call video URLs (comma-separated)
CALL_VIDEOS=https://archive.org/download/RickAstleyNeverGonnaGiveYouUp/RickAstleyNeverGonnaGiveYouUp.mp4

# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
STUDENT_REQUESTS_OPEN=true

# ─────────────────────────────────────────────
# NOTIFICATIONS
# ─────────────────────────────────────────────
# Discord webhook URLs for student request notifications
DISCORD_WEBHOOK_URL=
# Discord webhook for child safety alerts (used by AI system)
DISCORD_CHILD_SAFETY_WEBHOOK=

# Telegram bot for analytics reports and alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_BOT_ID=

# OneSignal push notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
