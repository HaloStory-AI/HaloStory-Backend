# App
APP_NAME=HaloStory
APP_URL=http://localhost:18000
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_TTL_HOURS=168h
APP_DEBUG=true
TIMEZONE=Asia/Jakarta

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bluetalk
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_ADDR=127.0.0.1:6379
